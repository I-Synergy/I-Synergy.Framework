<c:View
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:ISynergy.Framework.UI.Controls"
    xmlns:m="using:ISynergy.Framework.UI.Markup"
    x:Class="Sample.Views.SettingsView">

    <!-- Settings surface matching the Sample.Maui settings drawer. -->
    <Grid Padding="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="{Binding Title}"
            Style="{StaticResource AppSettingsHeader}" />

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="{m:LanguageResource Key=Language}" Style="{StaticResource AppSettingsLabel}" />
                    <ComboBox
                        ItemsSource="{Binding AvailableLanguages}"
                        SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                        Style="{StaticResource AppSettingsField}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{m:LanguageResource Key=Theme}" Style="{StaticResource AppSettingsLabel}" />
                    <ComboBox
                        ItemsSource="{Binding AvailableThemes}"
                        SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                        Style="{StaticResource AppSettingsField}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="{m:LanguageResource Key=AccentColor}" Style="{StaticResource AppSettingsLabel}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="AccentTeal"
                            Tag="#0B5D55"
                            Background="#0B5D55"
                            Style="{StaticResource AppAccentSwatch}"
                            Click="OnAccentClicked" />
                        <Button
                            x:Name="AccentBlue"
                            Tag="#0066CC"
                            Background="#0066CC"
                            Style="{StaticResource AppAccentSwatch}"
                            Click="OnAccentClicked" />
                        <Button
                            x:Name="AccentGreen"
                            Tag="#10B981"
                            Background="#10B981"
                            Style="{StaticResource AppAccentSwatch}"
                            Click="OnAccentClicked" />
                        <Button
                            x:Name="AccentOrange"
                            Tag="#FF8C00"
                            Background="#FF8C00"
                            Style="{StaticResource AppAccentSwatch}"
                            Click="OnAccentClicked" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Button
            Grid.Row="2"
            Content="{m:LanguageResource Key=Close}"
            Style="{StaticResource AppPrimaryButton}"
            Command="{Binding CloseCommand}"
            Margin="0,22,0,0" />
    </Grid>
</c:View>
