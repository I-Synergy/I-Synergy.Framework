<c:View xmlns:c="clr-namespace:ISynergy.Framework.UI.Controls;assembly=ISynergy.Framework.UI.WPF"
        x:Class="Sample.Views.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:converters="clr-namespace:ISynergy.Framework.UI.Converters;assembly=ISynergy.Framework.UI.WPF"
        xmlns:models="clr-namespace:ISynergy.Framework.Core.Models;assembly=ISynergy.Framework.Core"
        xmlns:services="clr-namespace:ISynergy.Framework.Globalization.Services;assembly=ISynergy.Framework.Globalization"
        mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="800"
        Title="{Binding Title}">

    <c:View.Resources>
        <converters:StringToGeometryConverter x:Key="StringToGeometryConverter" />
    </c:View.Resources>

    <Grid>
        <!-- Example of LocalizedStrings.Default indexer binding for live language switching -->
        <TextBlock Text="{Binding [Info], Source={x:Static services:LocalizedStrings.Default}}"
                   Margin="10,5,10,0" FontSize="11" Opacity="0.7" ToolTip="This text updates when language changes"/>

        <syncfusion:SfNavigationDrawer x:Name="NavigationView"
                                   ItemsSource="{Binding PrimaryItems}"
                                   DisplayMode="Compact"
                                   ItemClicked="NavigationView_ItemClicked">
            <syncfusion:SfNavigationDrawer.ItemTemplate>
                <DataTemplate DataType="models:NavigationItem">
                    <StackPanel Margin="-32,0,0,0" HorizontalAlignment="Left" Orientation="Horizontal">
                        <Path Data="{Binding Icon, Converter={StaticResource StringToGeometryConverter}}"
                              Fill="{Binding RelativeSource={RelativeSource AncestorType=syncfusion:SfNavigationDrawer}, Path=Foreground}"
                              Width="16" Height="16" Stretch="Uniform"
                              VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" 
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Margin="12,0,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </syncfusion:SfNavigationDrawer.ItemTemplate>
            <syncfusion:SfNavigationDrawer.ContentView>
                <Frame x:Name="ContentRootControl" NavigationUIVisibility="Hidden" Margin="10"/>
            </syncfusion:SfNavigationDrawer.ContentView>
        </syncfusion:SfNavigationDrawer>

        <c:LoadingSpinner Visibility="{Binding CommonServices.BusyService.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" Message="{Binding CommonServices.BusyService.BusyMessage, Mode=OneWay}" />
    </Grid>
</c:View>
