<?xml version="1.0" encoding="utf-8" ?>
<c:View
    x:Class="Sample.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:ISynergy.Framework.UI.Controls;assembly=ISynergy.Framework.UI.Maui"
    xmlns:m="clr-namespace:ISynergy.Framework.UI.Markup;assembly=ISynergy.Framework.UI.Maui"
    xmlns:viewmodels="clr-namespace:Sample.ViewModels"
    x:DataType="viewmodels:SettingsViewModel"
    Title="{m:GetString Settings}">

    <!-- Settings blade page. Language, theme and accent color are applied live and persisted;
         Save & close persists everything and closes the blade, Close discards (cancel). -->
    <Border
        BackgroundColor="{AppThemeBinding Light={DynamicResource TintedGray100}, Dark={DynamicResource TintedGray900}}"
        Stroke="{AppThemeBinding Light={StaticResource AppBorderLight}, Dark={StaticResource AppBorderDark}}">
        <Grid RowDefinitions="Auto,*,Auto" Padding="16,20" RowSpacing="12">

            <!-- Header -->
            <Label
                Grid.Row="0"
                Text="{Binding Title}"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light={DynamicResource OffBlack}, Dark={DynamicResource White}}" />

            <!-- Content -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="16" Padding="0,8">

                    <!-- Language -->
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="{m:GetString Language}"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Gray500}" />
                        <Picker
                            x:Name="LanguagePicker"
                            ItemsSource="{Binding LanguageOptions}"
                            SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                    </VerticalStackLayout>

                    <!-- Theme -->
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="{m:GetString Theme}"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Gray500}" />
                        <Picker
                            x:Name="ThemePicker"
                            ItemsSource="{Binding ThemeOptions}"
                            SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                    </VerticalStackLayout>

                    <!-- Accent Color -->
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="{m:GetString AccentColor}"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="{DynamicResource Gray500}" />
                        <HorizontalStackLayout Spacing="8" Margin="0,4">
                            <Button
                                x:Name="ColorTeal"
                                WidthRequest="48"
                                HeightRequest="48"
                                CornerRadius="4"
                                BackgroundColor="#0B5D55"
                                Clicked="OnColorClicked"
                                CommandParameter="#0B5D55" />
                            <Button
                                x:Name="ColorBlue"
                                WidthRequest="48"
                                HeightRequest="48"
                                CornerRadius="4"
                                BackgroundColor="#0066CC"
                                Clicked="OnColorClicked"
                                CommandParameter="#0066CC" />
                            <Button
                                x:Name="ColorGreen"
                                WidthRequest="48"
                                HeightRequest="48"
                                CornerRadius="4"
                                BackgroundColor="#10B981"
                                Clicked="OnColorClicked"
                                CommandParameter="#10B981" />
                            <Button
                                x:Name="ColorOrange"
                                WidthRequest="48"
                                HeightRequest="48"
                                CornerRadius="4"
                                BackgroundColor="#FF8C00"
                                Clicked="OnColorClicked"
                                CommandParameter="#FF8C00" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <!-- Footer -->
            <VerticalStackLayout Grid.Row="2" Spacing="8">
                <Button
                    Text="Save &amp; close"
                    BackgroundColor="{DynamicResource Primary}"
                    TextColor="White"
                    Command="{Binding SaveCommand}" />
                <Button
                    Text="{m:GetString Close}"
                    Command="{Binding CancelCommand}" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</c:View>
