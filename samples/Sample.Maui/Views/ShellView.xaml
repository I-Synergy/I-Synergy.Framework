<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Sample.Views.ShellView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:Sample.ViewModels"
    xmlns:views="clr-namespace:Sample.Views"
    x:DataType="viewmodels:ShellViewModel"
    FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="{AppThemeBinding Light={DynamicResource TintedGray100}, Dark={DynamicResource TintedGray900}}">

    <ShellContent
        Title="Dashboard"
        Icon="{DynamicResource IconInformation}"
        ContentTemplate="{DataTemplate views:InfoView}"
        Route="dashboard" />

    <ShellContent
        Title="Custom Controls"
        Icon="{DynamicResource IconCustomControls}"
        ContentTemplate="{DataTemplate views:CustomControlsView}"
        Route="customcontrols" />

    <ShellContent
        Title="Maui Controls"
        Icon="{DynamicResource IconMauiControls}"
        ContentTemplate="{DataTemplate views:MauiControlsView}"
        Route="mauicontrols" />

    <ShellContent
        Title="Slide Show"
        Icon="{DynamicResource IconSlideShow}"
        ContentTemplate="{DataTemplate views:SlideShowView}"
        Route="slideshow" />

    <Shell.FlyoutFooter>
        <Grid Margin="20" HorizontalOptions="Center">
            <HorizontalStackLayout Spacing="20">
                <Button Text="{StaticResource help}"
                        TextColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource White}}"
                        ToolTipProperties.Text="Help"
                        Style="{DynamicResource IconOnlyButton}"
                        Command="{Binding HelpCommand}" />
                <Button Text="{StaticResource language}"
                        TextColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource White}}"
                        ToolTipProperties.Text="Language"
                        Style="{DynamicResource IconOnlyButton}"
                        Command="{Binding LanguageCommand}" />
                <Button Text="{StaticResource theme}"
                        TextColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource White}}"
                        ToolTipProperties.Text="Theme"
                        Style="{DynamicResource IconOnlyButton}"
                        Command="{Binding ThemeCommand}" />
                <Button Text="{StaticResource settings}"
                        TextColor="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource White}}"
                        ToolTipProperties.Text="Settings"
                        Style="{DynamicResource IconOnlyButton}"
                        Command="{Binding SettingsCommand}" />
            </HorizontalStackLayout>
        </Grid>
    </Shell.FlyoutFooter>
</Shell>
