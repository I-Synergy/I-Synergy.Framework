<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Sample.Views.ShellView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:ISynergy.Framework.UI.Markup;assembly=ISynergy.Framework.UI.Maui"
    xmlns:c="clr-namespace:ISynergy.Framework.UI.Controls;assembly=ISynergy.Framework.UI.Maui"
    xmlns:converters="clr-namespace:ISynergy.Framework.UI.Converters;assembly=ISynergy.Framework.UI.Maui"
    xmlns:viewmodels="clr-namespace:Sample.ViewModels"
    xmlns:views="clr-namespace:Sample.Views"
    x:DataType="viewmodels:ShellViewModel"
    FlyoutBehavior="Flyout"
    FlyoutBackgroundColor="{AppThemeBinding Light={DynamicResource TintedGray100}, Dark={DynamicResource TintedGray900}}">

    <Shell.MenuBarItems>
        <MenuBarItem Text="File">
            <MenuFlyoutItem Text="Settings" Command="{Binding SettingsCommand}"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Sign Out" Command="{Binding SignInCommand}"/>
        </MenuBarItem>
        <MenuBarItem Text="View">
            <MenuFlyoutItem Text="Language" Command="{Binding LanguageCommand}"/>
            <MenuFlyoutItem Text="Theme" Command="{Binding ThemeCommand}"/>
        </MenuBarItem>
        <MenuBarItem Text="Help">
            <MenuFlyoutItem Text="Help" Command="{Binding HelpCommand}"/>
            <MenuFlyoutItem Text="Feedback" Command="{Binding FeedbackCommand}"/>
        </MenuBarItem>
    </Shell.MenuBarItems>

    <ShellContent
        Title="Dashboard"
        Icon="{DynamicResource IconInformation}"
        ContentTemplate="{DataTemplate views:InfoView}"
        Route="dashboard" />

    <ShellContent
        Title="Custom Controls"
        Icon="{DynamicResource IconCustomControls}"
        ContentTemplate="{DataTemplate views:CustomControlsView}"
        Route="customcontrols" />

    <ShellContent
        Title="Maui Controls"
        Icon="{DynamicResource IconMauiControls}"
        ContentTemplate="{DataTemplate views:MauiControlsView}"
        Route="mauicontrols" />

    <ShellContent
        Title="Slide Show"
        Icon="{DynamicResource IconSlideShow}"
        ContentTemplate="{DataTemplate views:SlideShowView}"
        Route="slideshow" />

    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="4">
            <c:NavigationItem Text="Help" Icon="{DynamicResource IconHelp}" Command="{Binding HelpCommand}"/>
            <c:NavigationItem Text="Language" Icon="{DynamicResource IconLanguage}" Command="{Binding LanguageCommand}"/>
            <c:NavigationItem Text="Theme" Icon="{DynamicResource IconTheme}" Command="{Binding ThemeCommand}"/>
            <c:NavigationItem Text="Settings" Icon="{DynamicResource IconSettings}" Command="{Binding SettingsCommand}"/>
            <!--<c:NavigationItem Text="Signin" Icon="{DynamicResource IconSignin}" Command="{Binding SigninCommand}"/>-->
        </VerticalStackLayout>
    </Shell.FlyoutFooter>
</Shell>
