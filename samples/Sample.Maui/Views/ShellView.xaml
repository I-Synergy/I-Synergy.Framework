<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Sample.Views.ShellView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:ISynergy.Framework.UI.Markup;assembly=ISynergy.Framework.UI.Maui"
    xmlns:c="clr-namespace:ISynergy.Framework.UI.Controls;assembly=ISynergy.Framework.UI.Maui"
    xmlns:converters="clr-namespace:ISynergy.Framework.UI.Converters;assembly=ISynergy.Framework.UI.Maui"
    xmlns:viewmodels="clr-namespace:Sample.ViewModels"
    xmlns:views="clr-namespace:Sample.Views"
    xmlns:controls="clr-namespace:Sample.Views.Controls"
    xmlns:local="clr-namespace:Sample.Services"
    x:Name="ShellRoot"
    x:DataType="viewmodels:ShellViewModel"
    FlyoutBehavior="{OnPlatform WinUI=Locked, MacCatalyst=Locked, iOS=Disabled, Android=Disabled}"
    FlyoutBackgroundColor="Transparent"
    FlyoutWidth="300"
    Shell.BackgroundColor="{AppThemeBinding Light={StaticResource AppBgLight}, Dark={StaticResource AppBgDark}}"
    Shell.ForegroundColor="{AppThemeBinding Light={StaticResource AppTextLight}, Dark={StaticResource AppTextDark}}"
    Shell.NavBarIsVisible="True"
    Shell.TitleColor="{AppThemeBinding Light={StaticResource AppTextLight}, Dark={StaticResource AppTextDark}}">

    <!-- Permanent desktop sidebar; on phones the FlyoutBehavior is Disabled and the
         four ShellContents render as a bottom tab bar instead. -->
    <Shell.FlyoutContent>
        <controls:SidebarView x:Name="Sidebar" BindingContext="{Binding BindingContext, Source={x:Reference ShellRoot}}" />
    </Shell.FlyoutContent>

    <Shell.TitleView>
        <controls:AppHeaderView BindingContext="{Binding BindingContext, Source={x:Reference ShellRoot}}" />
    </Shell.TitleView>

    <TabBar Shell.TabBarIsVisible="{OnPlatform WinUI=False, MacCatalyst=False, iOS=True, Android=True}">

        <ShellContent
            Title="Dashboard"
            Icon="{DynamicResource IconInformation}"
            ContentTemplate="{DataTemplate views:InfoView}"
            Route="dashboard" />

        <ShellContent
            Title="Custom Controls"
            Icon="{DynamicResource IconCustomControls}"
            ContentTemplate="{DataTemplate views:CustomControlsView}"
            Route="customcontrols" />

        <ShellContent
            Title="Maui Controls"
            Icon="{DynamicResource IconMauiControls}"
            ContentTemplate="{DataTemplate views:MauiControlsView}"
            Route="mauicontrols" />

        <ShellContent
            Title="Slide Show"
            Icon="{DynamicResource IconSlideShow}"
            ContentTemplate="{DataTemplate views:SlideShowView}"
            Route="slideshow" />

    </TabBar>
</Shell>
