<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:Sample.ViewModels"
    x:Class="Sample.Views.Controls.AppHeaderTrailingView"
    x:DataType="viewmodels:ShellViewModel">

    <!--
        Title-bar trailing island. It ends before the native caption buttons, so the gap
        between the last app button and minimise stays part of the draggable title bar.
    -->
    <HorizontalStackLayout Spacing="4" VerticalOptions="Center" Padding="0,0,8,0">
        <!-- Theme toggle: moon when light, sun when dark -->
        <Button Text="{Binding ThemeIcon}"
                StyleId="HeaderIconButton"
                FontFamily="FluentUI"
                Style="{StaticResource AppVerseActionButton}"
                TextColor="{AppThemeBinding Light={StaticResource AppMutedLight}, Dark={StaticResource AppMutedDark}}"
                Command="{Binding ThemeCommand}" />
        <!-- Settings: sliders icon -->
        <Button Text="&#xf588;"
                StyleId="HeaderIconButton"
                FontFamily="FluentUI"
                Style="{StaticResource AppVerseActionButton}"
                TextColor="{AppThemeBinding Light={StaticResource AppMutedLight}, Dark={StaticResource AppMutedDark}}"
                Command="{Binding SettingsCommand}" />
    </HorizontalStackLayout>

</ContentView>
