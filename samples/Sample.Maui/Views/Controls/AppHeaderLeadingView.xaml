<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:ISynergy.Framework.UI.Markup;assembly=ISynergy.Framework.UI.Maui"
    xmlns:viewmodels="clr-namespace:Sample.ViewModels"
    x:Class="Sample.Views.Controls.AppHeaderLeadingView"
    x:DataType="viewmodels:ShellViewModel">

    <!--
        Title-bar leading island. Interactive elements live here; the empty title-bar centre
        (Title/Subtitle) remains the native drag region.
    -->
    <HorizontalStackLayout Spacing="8" VerticalOptions="Center" Padding="2,0,0,0">

        <!-- Menu: first, so its icon sits on the same column as the sidebar's icons. -->
        <Button
            Text="&#x2630;"
            StyleId="HeaderIconButton"
            Command="{Binding ToggleMenuCommand}"
            Style="{StaticResource AppVerseActionButton}"
            FontSize="18"
            VerticalOptions="Center" />

        <!-- Back: visible while the navigation service has a page to return to. -->
        <Button
            Text="&#x2190;"
            StyleId="HeaderIconButton"
            IsVisible="{Binding IsBackEnabled}"
            Command="{Binding BackCommand}"
            Style="{StaticResource AppVerseActionButton}"
            FontSize="18"
            VerticalOptions="Center" />

    </HorizontalStackLayout>

</ContentView>
