<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:ISynergy.Framework.UI.Markup;assembly=ISynergy.Framework.UI.Maui"
    xmlns:viewmodels="clr-namespace:Sample.ViewModels"
    x:Class="Sample.Views.Controls.AppHeaderView"
    x:DataType="viewmodels:ShellViewModel">

    <!-- 880px centred column with 40px side padding (matches content width on desktop) -->
    <Grid>
        <Grid HorizontalOptions="Fill">
            <Grid x:Name="HeaderBar" ColumnDefinitions="*,Auto" ColumnSpacing="8" HeightRequest="48">
                <!-- The header is an in-page row again (no title-bar overlay), so the gutters are plain
                     padding. Left 20 centres the 44px menu button on x=42 — the centre of the sidebar's
                     icon column (panel padding 16 + row padding 8 + 36px tile / 2). Right 16 puts the
                     theme/settings buttons at the window edge. Mac Catalyst keeps an 80px left gutter
                     because its window is translucent under the traffic lights. -->
                <Grid.Padding>
                    <OnPlatform x:TypeArguments="Thickness" Default="20,0,16,0">
                        <On Platform="WinUI" Value="20,0,16,0" />
                        <On Platform="macOS" Value="20,0,16,0" />
                        <On Platform="MacCatalyst" Value="80,0,40,0" />
                        <On Platform="iOS" Value="16,0" />
                        <On Platform="Android" Value="16,0" />
                    </OnPlatform>
                </Grid.Padding>

                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">

                    <HorizontalStackLayout x:Name="ShellButtons" Spacing="8">

                    <!-- Menu: first, so its icon sits on the same column as the sidebar's icons. -->
                    <Button
                        Text="&#x2630;"
                        StyleId="HeaderIconButton"
                        Command="{Binding ToggleMenuCommand}"
                        Style="{StaticResource AppVerseActionButton}"
                        FontSize="18"
                        VerticalOptions="Center" />

                    <!-- Back: visible while the navigation service has a page to return to. -->
                    <Button
                        Text="&#x2190;"
                        StyleId="HeaderIconButton"
                        IsVisible="{Binding IsBackEnabled}"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource AppVerseActionButton}"
                        FontSize="18"
                        VerticalOptions="Center" />

                    </HorizontalStackLayout>

                    <!-- Breadcrumb: app name (link) / muted slash / current page (bold) -->
                    <!-- First breadcrumb: app name as accent link, tappable to navigate to dashboard -->
                    <Label Text="{m:LocalizedStrings Key=ApplicationName}"
                           StyleId="LinkLabel"
                           Style="{StaticResource AppBreadcrumbLinkLabel}"
                           TextColor="{AppThemeBinding Light={DynamicResource AppAccentLight}, Dark={DynamicResource AppAccentDark}}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding NavigateToCommand}"
                                CommandParameter="dashboard" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Text="/"
                           Style="{StaticResource AppBreadcrumbLabel}"
                           TextColor="{AppThemeBinding Light={StaticResource AppMutedLight}, Dark={StaticResource AppMutedDark}}"
                           VerticalOptions="Center" />

                    <!-- Current page breadcrumb -->
                    <Label Text="{Binding CrumbCurrent}"
                           Style="{StaticResource AppBreadcrumbCurrentLabel}"
                           TextColor="{AppThemeBinding Light={StaticResource AppTextLight}, Dark={StaticResource AppTextDark}}"
                           VerticalOptions="Center" />

                </HorizontalStackLayout>

                <HorizontalStackLayout x:Name="TrailingButtons" Grid.Column="1" Spacing="4" VerticalOptions="Center" HorizontalOptions="End">
                    <!-- Theme toggle: moon when light, sun when dark -->
                    <Button Text="{Binding ThemeIcon}"
                            StyleId="HeaderIconButton"
                            FontFamily="FluentUI"
                            Style="{StaticResource AppVerseActionButton}"
                            TextColor="{AppThemeBinding Light={StaticResource AppMutedLight}, Dark={StaticResource AppMutedDark}}"
                            Command="{Binding ThemeCommand}" />
                    <!-- Settings: sliders icon -->
                    <Button Text="&#xf588;"
                            StyleId="HeaderIconButton"
                            FontFamily="FluentUI"
                            Style="{StaticResource AppVerseActionButton}"
                            TextColor="{AppThemeBinding Light={StaticResource AppMutedLight}, Dark={StaticResource AppMutedDark}}"
                            Command="{Binding SettingsCommand}" />
                </HorizontalStackLayout>

            </Grid>
        </Grid>
    </Grid>

</ContentView>
