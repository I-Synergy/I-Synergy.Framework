<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- .NET 11 only. .NET 10 built Android and Mac Catalyst on Mono, so those builds could not
		     be debugged with the CoreCLR debugger; .NET 11 runs CoreCLR on Android and Apple.
		     ISynergy.Framework.UI.Maui still multi-targets net10 for its consumers.
		     The macOS (AppKit) head is macOS-host only and is listed before Mac Catalyst on purpose:
		     tooling that resolves a platform by substring ("mac") takes the first match. -->
		<TargetFrameworks>net11.0-android;net11.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net11.0-macos</TargetFrameworks>
		<TargetFrameworks>$(TargetFrameworks);net11.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.26100.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is
		maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular
		<RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>Sample</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<IsPackable>false</IsPackable>
		<WindowsPackageType>None</WindowsPackageType>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<!-- Display name -->
		<ApplicationTitle>Sample</ApplicationTitle>
		<Product>Maui Sample</Product>
		<!-- App Identifier -->
		<ApplicationId>com.companyname.Sample</ApplicationId>
		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<!-- Align Version with ApplicationDisplayVersion to prevent PackageVersion conflict across TFs -->
		<Version>$(ApplicationDisplayVersion)</Version>

		<!-- Workaround: multi-targeted MAUI projects don't expose GetTargetPath in the outer build,
			which breaks VS Build Acceleration and Aspire AppHost project reference resolution. -->
		<GetTargetPathDependsOn>$(GetTargetPathDependsOn)</GetTargetPathDependsOn>
	</PropertyGroup>

  <Target Name="GetTargetPath" />

  <Choose>
    <When Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
      <PropertyGroup>
        <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
      </PropertyGroup>
    </When>
    <When Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
      <PropertyGroup>
        <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>

        <CodesignKey>Apple Development: Created via API (Y4Q66R3GZS)</CodesignKey>
        <CodesignProvision>VS: WildCard Development</CodesignProvision>
      </PropertyGroup>

      <!-- This allows breakpoints to be hit when debugging!-->
      <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <MtouchDebug>true</MtouchDebug>
      </PropertyGroup>

      <PropertyGroup>
        <EnableAssemblyILStripping>false</EnableAssemblyILStripping>
      </PropertyGroup>
    </When>
    <When Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
      <PropertyGroup>
        <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
        <!-- Debug runs without the App Sandbox: a sandboxed debugger/terminal cannot start a
             sandboxed bundle directly (libsecinit aborts with SYSCALL_SET_USERLAND_PROFILE).
             Release keeps Platforms/MacCatalyst/Entitlements.plist. -->
        <CodesignEntitlements Condition="'$(Configuration)' == 'Debug'">Platforms/MacCatalyst/Entitlements.Debug.plist</CodesignEntitlements>
      </PropertyGroup>
    </When>
    <When Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">
      <PropertyGroup>
        <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
      </PropertyGroup>
    </When>
    <When Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
      <PropertyGroup>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>

        <WindowsAppSdkSelfContained>true</WindowsAppSdkSelfContained>
        <SelfContained>true</SelfContained>
        <PublishReadyToRun>true</PublishReadyToRun>
      </PropertyGroup>

      <PropertyGroup Condition="'$(RuntimeIdentifierOverride)' != ''">
        <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
      </PropertyGroup>
    </When>
  </Choose>

	<ItemGroup>
		<!-- App Icon (Resizetizer). Not used by the macOS/AppKit TFM: its icon target renders the
		     source with sips, which cannot read SVG, so that target gets the PNG icon instead. -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FFFFFF"
		          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'macos'" />
		<!-- Splash Screen -->
		<!-- Splash is a PNG on purpose: the MAUI 11 RC Resizetizer crashes on SVG text (Svg.Skia/Microsoft.Maui.Resizetizer 11.0.0-rc.2 -> MAUIR0005,
		     MissingMethodException in SKTextBlobBuilder.AddPositionedRun) and the source SVG contains the wordmarks as <text>. splash.svg is kept next to
		     this file as the editable source; re-rendering it to splash.png is what produces the PNG. -->
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#17171a"
		                  Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'macos'" />
		<!-- macOS app icon: AppKit builds an .icns from a raster source. -->
		<MauiIcon Include="Resources\Images\icon.png"
		          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'" />
		
		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />
		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="appsettings.Staging.json">
      <DependentUpon>appsettings.json</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="appsettings.Development.json">
      <DependentUpon>appsettings.json</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="appsettings.json" />
    <EmbeddedResource Include="appsettings.Production.json">
      <DependentUpon>appsettings.json</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" />
		<PackageReference Include="Microsoft.Maui.Controls" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
		<PackageReference Include="Microsoft.Maui.DevFlow.Agent" />
		<PackageReference Include="Syncfusion.Maui.Core" />
	</ItemGroup>

	<!-- Native macOS (AppKit) hosting + Essentials. Mac Catalyst keeps the MAUI/Microsoft.Maui.Controls
	     hosting path, so these are scoped to the macos TFM only. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">
		<PackageReference Include="Microsoft.Maui.Platforms.MacOS" />
		<PackageReference Include="Microsoft.Maui.Platforms.MacOS.Essentials" />
	</ItemGroup>

	<!-- The MAUI single-project convention only knows the Android/iOS/MacCatalyst/Windows/Tizen
	     platform folders, so for the macos TFM it removes Platforms/** without re-adding Platforms/MacOS.
	     Re-include those sources after that removal (evaluation-time items would be removed again). -->
	<Target Name="_IncludeMacOSPlatformSources"
	        BeforeTargets="CoreCompile"
	        Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'macos'">
		<ItemGroup>
			<Compile Include="Platforms\MacOS\**\*.cs" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<ProjectReference Include="..\..\src\ISynergy.Framework.Core\ISynergy.Framework.Core.csproj" />
		<ProjectReference Include="..\..\src\ISynergy.Framework.Mvvm\ISynergy.Framework.Mvvm.csproj" />
		<ProjectReference Include="..\..\src\ISynergy.Framework.OpenTelemetry.ApplicationInsights\ISynergy.Framework.OpenTelemetry.ApplicationInsights.csproj" />
		<ProjectReference Include="..\..\src\ISynergy.Framework.OpenTelemetry.Sentry\ISynergy.Framework.OpenTelemetry.Sentry.csproj" />
		<ProjectReference Include="..\..\src\ISynergy.Framework.OpenTelemetry\ISynergy.Framework.OpenTelemetry.csproj" />
		<ProjectReference Include="..\..\src\ISynergy.Framework.UI.Maui\ISynergy.Framework.UI.Maui.csproj" />
		<ProjectReference Include="..\..\src\ISynergy.Framework.UI\ISynergy.Framework.UI.csproj" />
		<ProjectReference Include="..\Sample.Shared\Sample.Shared.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Using Include="ISynergy.Framework.UI.Controls.View">
			<Alias>View</Alias>
		</Using>
		<Using Include="ISynergy.Framework.Mvvm.Abstractions.IView">
			<Alias>IView</Alias>
		</Using>
		<Using Include="ISynergy.Framework.UI.Controls.Window">
			<Alias>Window</Alias>
		</Using>
		<Using Include="ISynergy.Framework.Mvvm.Abstractions.IWindow">
			<Alias>IWindow</Alias>
		</Using>
	</ItemGroup>

  <ItemGroup>
    <MauiFont Update="Resources\Fonts\FluentSystemIconsRegular.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </MauiFont>
    <MauiFont Update="Resources\Fonts\FontAwesomeRegular.otf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </MauiFont>
    <MauiFont Update="Resources\Fonts\OpenSans-Regular.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </MauiFont>
    <MauiFont Update="Resources\Fonts\OpenSans-Semibold.ttf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </MauiFont>
  </ItemGroup>
  
	<ItemGroup>
		<MauiXaml Update="Views\ControlsView.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\DetailsView.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\DetailView.xaml.cs">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Resources\Styles\Colors.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Resources\Styles\Images.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Resources\Styles\Style.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\DetailView.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\SlideShowView.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\SettingsView.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\TestExceptionWindow.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>
</Project>