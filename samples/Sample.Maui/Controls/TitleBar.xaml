<?xml version="1.0" encoding="utf-8" ?>
<TitleBar xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
          xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
          x:Class="Sample.Controls.TitleBar"
          HeightRequest="48"
          Icon="icon.png"
          BackgroundColor="{AppThemeBinding Light={DynamicResource TintedGray100}, Dark={DynamicResource TintedGray900}}">
    <TitleBar.Content>
        <HorizontalStackLayout Spacing="8"
                               HorizontalOptions="End">
            <SearchBar x:Name="SearchField"
                       Placeholder="Search"
                       MinimumWidthRequest="300"
                       VerticalOptions="{OnPlatform MacCatalyst=End, Default=Center}"/>
        </HorizontalStackLayout>
    </TitleBar.Content>
    <TitleBar.TrailingContent>
        <HorizontalStackLayout Spacing="8">
            <Button HeightRequest="36"
                    WidthRequest="36"
                    BorderWidth="0"
                    Background="Transparent"
                    Text="&#xf013;"
                    VerticalOptions="Center"
                    Style="{DynamicResource IconOnlyButton}"/>

            <Button HeightRequest="36"
                    WidthRequest="36"
                    BorderWidth="0"
                    Background="Transparent"
                    Text="&#xf013;"
                    VerticalOptions="Center"
                    Style="{DynamicResource IconOnlyButton}"/>
        </HorizontalStackLayout>
    </TitleBar.TrailingContent>
</TitleBar>
