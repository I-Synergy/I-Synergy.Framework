<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="Sample.Resources.Styles.Images"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <x:Double x:Key="sizeNone">0</x:Double>
    <x:Double x:Key="size20">2</x:Double>
    <x:Double x:Key="size40">4</x:Double>
    <x:Double x:Key="size60">6</x:Double>
    <x:Double x:Key="size80">8</x:Double>
    <x:Double x:Key="size100">10</x:Double>
    <x:Double x:Key="size120">12</x:Double>
    <x:Double x:Key="size160">16</x:Double>
    <x:Double x:Key="size200">20</x:Double>
    <x:Double x:Key="size240">24</x:Double>
    <x:Double x:Key="size280">28</x:Double>
    <x:Double x:Key="size320">32</x:Double>
    <x:Double x:Key="size360">36</x:Double>
    <x:Double x:Key="size400">40</x:Double>
    <x:Double x:Key="size480">48</x:Double>
    <x:Double x:Key="size520">52</x:Double>
    <x:Double x:Key="size560">56</x:Double>

    <OnIdiom x:Key="IconSize"
          x:TypeArguments="x:Double"
          Default="20">
        <OnIdiom.Desktop>14</OnIdiom.Desktop>
    </OnIdiom>

    <OnIdiom x:Key="IconSizeSmall"
          x:TypeArguments="x:Double"
          Default="12">
        <OnIdiom.Desktop>18</OnIdiom.Desktop>
    </OnIdiom>

    <OnIdiom x:Key="LayoutPadding"
          x:TypeArguments="Thickness"
          Default="15">
        <OnIdiom.Desktop>30</OnIdiom.Desktop>
    </OnIdiom>

    <OnIdiom x:Key="LayoutSpacing"
          x:TypeArguments="x:Double"
          Default="5">
        <OnIdiom.Desktop>15</OnIdiom.Desktop>
    </OnIdiom>

    <x:String x:Key="language">&#xf1ab;</x:String>
    <x:String x:Key="theme">&#xf53f;</x:String>
    <x:String x:Key="settings">&#xf013;</x:String>
    <x:String x:Key="help">&#xe14b;</x:String>
    <x:String x:Key="signin">&#xe058;</x:String>
    <x:String x:Key="info">&#xf685;</x:String>
    <x:String x:Key="add">&#x2b;</x:String>
    <x:String x:Key="refresh">&#xf021;</x:String>
    <x:String x:Key="edit">&#xf304;</x:String>
    <x:String x:Key="delete">&#xf1f8;</x:String>
    <x:String x:Key="menu">&#xf0c9;</x:String>

    <FontImageSource x:Key="IconInformation"
        Glyph="&#xf685;"
        FontFamily="fontawesome"
        Color="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource White}}"
        Size="{StaticResource IconSize}" />

    <FontImageSource x:Key="IconCustomControls"
        Glyph="&#xf685;"
        FontFamily="fontawesome"
        Color="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource White}}"
        Size="{StaticResource IconSize}" />

    <FontImageSource x:Key="IconMauiControls"
        Glyph="&#xf685;"
        FontFamily="fontawesome"
        Color="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource White}}"
        Size="{StaticResource IconSize}" />

    <FontImageSource x:Key="IconSlideShow"
        Glyph="&#xf685;"
        FontFamily="fontawesome"
        Color="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource White}}"
        Size="{StaticResource IconSize}" />

    <FontImageSource x:Key="IconHelp"
        Glyph="&#xe14b;"
        FontFamily="fontawesome"
        Color="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource White}}"
        Size="{StaticResource IconSize}" />

    <FontImageSource x:Key="IconLanguage"
        Glyph="&#xf1ab;"
        FontFamily="fontawesome"
        Color="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource White}}"
        Size="{StaticResource IconSize}" />

    <FontImageSource x:Key="IconTheme"
        Glyph="&#xf53f;"
        FontFamily="fontawesome"
        Color="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource White}}"
        Size="{StaticResource IconSize}" />

    <FontImageSource x:Key="IconSettings"
        Glyph="&#xf013;"
        FontFamily="fontawesome"
        Color="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource White}}"
        Size="{StaticResource IconSize}" />

    <FontImageSource x:Key="IconSignin"
        Glyph="&#xe058;"
        FontFamily="fontawesome"
        Color="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource White}}"
        Size="{StaticResource IconSize}" />
</ResourceDictionary>