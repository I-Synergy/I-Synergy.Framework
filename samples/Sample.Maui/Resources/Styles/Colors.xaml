<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="Sample.Resources.Styles.Colors"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />

    <!-- =====================================================================
         Sample-neutral design tokens based on reference app (The Quran).
         Accent tokens (AppAccent, AppAccentSoft, AppBrandHero) are fixed
         to the framework's Primary/AccentColor resource so they update when
         IThemeService.SetAccentColor is called (live accent switching).
         ===================================================================== -->

    <!-- ── Surfaces and text (light/dark pairs) ────────────────────────── -->

    <Color x:Key="AppBgLight">#F4F6F3</Color>
    <Color x:Key="AppBgDark">#0D1614</Color>

    <Color x:Key="AppSurfaceLight">#FFFFFF</Color>
    <Color x:Key="AppSurfaceDark">#14201C</Color>

    <Color x:Key="AppSurface2Light">#E8EDE9</Color>
    <Color x:Key="AppSurface2Dark">#1C2A25</Color>

    <Color x:Key="AppBorderLight">#E0E6E2</Color>
    <Color x:Key="AppBorderDark">#26352F</Color>

    <Color x:Key="AppTextLight">#14211E</Color>
    <Color x:Key="AppTextDark">#EEF1EA</Color>

    <Color x:Key="AppMutedLight">#55665F</Color>
    <Color x:Key="AppMutedDark">#9CB0A8</Color>

    <!-- ── Accents (derived from Primary, not hardcoded) ──────────────── -->

    <!-- Soft accent fill for selected rows, badges. Fixed to Primary at 16% opacity (light) -->
    <Color x:Key="AppAccentSoftLight">#E1EEEA</Color>
    <Color x:Key="AppAccentSoftDark">#295ED3B0</Color>

    <!-- Breadcrumb accent color: dark teal for light mode, light cyan for dark mode (high contrast) -->
    <Color x:Key="AppAccentLight">#0B5D55</Color>
    <Color x:Key="AppAccentDark">#5ED3B0</Color>

    <!-- Text drawn on accent fill. -->
    <Color x:Key="AppInkLight">#FFFFFF</Color>
    <Color x:Key="AppInkDark">#04231A</Color>

    <!-- ── Single-key dynamic theme colors (updated at runtime) ───────── -->

    <!-- These are filled at app startup based on the current theme.
         Components use DynamicResource to pick up theme changes. -->
    <Color x:Key="AppBg">#000000</Color>
    <Color x:Key="AppSurface">#000000</Color>
    <Color x:Key="AppSurface2">#000000</Color>
    <Color x:Key="AppBorder">#000000</Color>
    <Color x:Key="AppText">#000000</Color>
    <Color x:Key="AppMuted">#000000</Color>
    <Color x:Key="AppInk">#000000</Color>

    <!-- Accent colors: derived from Primary and updated dynamically when accent changes via ShellAccentTokens -->
    <!-- Accent brushes: always use framework Primary (updated by IThemeService.SetAccentColor) -->
    <SolidColorBrush x:Key="AppAccentBrush" Color="{DynamicResource Primary}" />
    <SolidColorBrush x:Key="AppAccentSoftBrush">
        <SolidColorBrush.Color>
            <!-- Soft accent at low alpha; updated when theme changes via ShellAccentTokens -->
            <Color>#295ED3B0</Color>
        </SolidColorBrush.Color>
    </SolidColorBrush>
    <SolidColorBrush x:Key="AppBrandHeroBrush" Color="{DynamicResource Primary}" />

    <!-- ── Shadows ──────────────────────────────────────────────────── -->

    <Shadow x:Key="AppSoftShadow"
            Brush="#14211E"
            Offset="0,3"
            Opacity="0.18"
            Radius="10" />

</ResourceDictionary>
