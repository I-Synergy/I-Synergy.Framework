@using ISynergy.Framework.Globalization.Constants
@using ISynergy.Framework.Core.Abstractions.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web

@inject ISettingsService SettingsService

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" dir="@GlobalizationConstants.GetDirection(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sample">
    <meta name="keywords" content="Sample">
    <title>Sample</title>
    <base href="/" />
    <link rel="stylesheet" href="site.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="Sample.Blazor.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    @* Apply the persisted theme before the first paint. The interactive render would otherwise
       flash the light palette while the circuit starts, even when the dark theme is selected
       (including "System" on an OS in dark mode). Themes.Default (0) follows the OS. *@
    <script>
        (function () {
            var preference = @((int)SettingsService.LocalSettings.Theme);
            var prefersDark = window.matchMedia
                && window.matchMedia('(prefers-color-scheme: dark)').matches;
            var isDark = preference === 2 || (preference === 0 && prefersDark);

            document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
        })();
    </script>
</head>

<body>
    <CascadingAuthenticationState>
        <Routes @rendermode="PageRenderMode" />
    </CascadingAuthenticationState>

    <div class="status-bar-safe-area"></div>

    @* v5: loading-theme.js is no longer shipped, and FluentDesignTheme /
       FluentDesignSystemProvider were removed. Theming is now pure CSS custom properties
       ("--colorBrandBackground", "color-scheme: dark", ...) applied by the library's own
       collocated JS module, which also injects css/default-fuib.css. No script tag is
       required — if runtime theming is ever needed, inject the IThemeService interface. *@

    <div id="app">
        <div class="loading-progress-text"></div>
        <div class="loading-info"></div>
    </div>

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <!-- highlight -->
    <script type="text/javascript" src="_content/I-Synergy.Framework.UI.Blazor/js/highlight_extensions.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
