@using ISynergy.Framework.AspNetCore.Blazor.Abstractions.Services
@using Microsoft.AspNetCore.Components;
@using Microsoft.AspNetCore.Components.Authorization;
@using Microsoft.FluentUI.AspNetCore.Components
@inject NavigationManager NavigationManager;
@inject INavigationMenuService NavigationMenuService;

@* v5: FluentNavMenu was removed and replaced by FluentNav.
   Title / Collapsible / CollapsedChildNavigation / CustomToggle no longer exist — the collapse
   is now owned by FluentLayout's hamburger (see Components/Layout/MainLayout.razor).
   Width changed from int? to a CSS string. *@
<FluentNav id="main_menu" Width="250px">
	@foreach (var item in NavigationMenuService.MenuItems)
	{
		<NavigationMenuItemControl Value="item" />
	}
</FluentNav>

@code {
	private bool _hasNavigatedToFirstItem = false;

	/// <summary>
	/// The authentication state published by the <c>CascadingAuthenticationState</c> in App.razor.
	/// </summary>
	/// <remarks>
	/// Taken from the cascading value instead of asking <c>AuthenticationStateProvider</c>
	/// directly: a provider queried without subscribing to its <c>AuthenticationStateChanged</c>
	/// event can hand out stale state (analyzer BL0013).
	/// </remarks>
	[CascadingParameter]
	private Task<AuthenticationState>? AuthenticationState { get; set; }

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender && !_hasNavigatedToFirstItem && AuthenticationState is not null)
		{
			var authState = await AuthenticationState;

			// Check if user is authenticated
			if (authState.User?.Identity?.IsAuthenticated == true && NavigationMenuService.MenuItems.Count > 0)
			{
				// Check if we're not already on a budgets page to avoid infinite navigation
				var currentUri = NavigationManager.Uri;
				var firstMenuItemHref = NavigationMenuService.MenuItems[0]?.Href;

				if (!string.IsNullOrEmpty(firstMenuItemHref) &&
					!currentUri.Equals($"{NavigationManager.BaseUri}{firstMenuItemHref}"))
				{
					_hasNavigatedToFirstItem = true;

					// Navigate to the first menu item (Dashboard)
					NavigationManager.NavigateTo(firstMenuItemHref);
				}
			}
		}

		await base.OnAfterRenderAsync(firstRender);
	}
}
