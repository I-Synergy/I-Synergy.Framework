@using ISynergy.Framework.AspNetCore.Blazor.Constants
@using ISynergy.Framework.Core.Services
@using Microsoft.FluentUI.AspNetCore.Components
@using Sample.Components.Controls

@* v5: FluentHeader / FluentBodyContent / FluentFooter were removed and replaced by the CSS-grid
   based FluentLayout + FluentLayoutItem (Area + optional Height/Width/Sticky).
   The navigation collapse is owned by FluentLayoutHamburger: on desktop it toggles the [hidden]
   attribute of the navigation area, on mobile it opens a drawer holding the same content.
   Display="DesktopMobile" is required, otherwise the hamburger is hidden above the breakpoint
   and the navigation would always stay expanded.
   Note: the shipped FluentLayoutHamburger JS leaves aria-expanded unset on first render, so the
   first desktop click collapses the navigation while setting aria-expanded="true" (upstream
   quirk); the show/hide behaviour itself toggles correctly on every click.
   NavigationDeferredLoading keeps exactly one copy of the navigation in the DOM: the hamburger
   drawer reuses the Navigation area's content, so without it the navigation (and its DOM ids)
   would be rendered twice. *@
<FluentLayout NavigationDeferredLoading="true">
	<FluentLayoutItem Area="LayoutArea.Header">
		<FluentLayoutHamburger Display="HamburgerDisplay.DesktopMobile" PanelHeader="Sample" />
		<FluentText Weight="TextWeight.Semibold">Sample</FluentText>
		<FluentSpacer />

		<!-- Theme Toggle Button: switches between Light (🌙) and Dark (☀️) -->
		<FluentButton OnClick="@ToggleTheme" Title="Toggle theme (light/dark)" IconOnly="true">
			@if (_localSettings?.Theme == ISynergy.Framework.Core.Enumerations.Themes.Light)
			{
				<span>🌙</span>
			}
			else
			{
				<span>☀️</span>
			}
		</FluentButton>

		<!-- Language Toggle: English ↔ Dutch -->
		<FluentButton OnClick="@ToggleLanguage" Title="Toggle language (English/Dutch)" IconOnly="true">
			🌐
		</FluentButton>
	</FluentLayoutItem>

	@* The navigation column follows the canonical v5 demo layout: an explicit height (the
	   --layout-body-height variable is published by FluentLayout itself, as
	   calc(var(--layout-height) - header height - footer height)), sticky positioning, its own
	   scrollbar and a divider. The Height parameter is required because v5.0.0 styles
	   [area="nav"][sticky] as `height: fit-content`.
	   No Width parameter on purpose: the grid's auto column is already sized by the navigation's
	   own Width="250px" (see NavigationMenuControl), and an explicit 250px item width would clip
	   1px off the navigation, since the border below is inside the border box.
	   One sizing rule cannot be expressed through these parameters and lives in site.css. *@
	<FluentLayoutItem Area="LayoutArea.Navigation" Height="var(--layout-body-height)" Sticky="true"
					  Style="overflow-y: auto; padding: 0px; border-right: var(--strokeWidthThin) solid var(--colorNeutralStroke1);">
		<NavigationMenuControl />
	</FluentLayoutItem>

	<FluentLayoutItem Area="LayoutArea.Content">
		@* v5 removed FluentMessageBarProvider.ClearAfterNavigation; the same behaviour is
		   emulated in MainLayout.razor.cs via INotificationService.CloseAllMessageBarsAsync(). *@
		<FluentMessageBarProvider Section="@MessageConstants.MESSAGES_TOP" />

		<div class="@ContentClass" style="display: flex; flex-direction: column; height: 100%;">
			<article id="article" class="@ArticleClass" style="margin: 4px; flex: 1; min-height: 0; display: flex; flex-direction: column;">
				@Body
			</article>
		</div>
	</FluentLayoutItem>

	<FluentLayoutItem Area="LayoutArea.Footer" Height="40px">
		<div class="version">
		</div>
		<FluentSpacer />
		<div class="copy">
		</div>
	</FluentLayoutItem>
</FluentLayout>

@* v5: FluentProviders replaces FluentDialogProvider + FluentToastProvider + FluentTooltipProvider +
   FluentKeyCodeProvider. It has no ChildContent, so it must be self-closing, and it does NOT
   include FluentMessageBarProvider (its Section parameter is required) — that stays separate above.
   FluentMenuProvider was removed in v5: the menu service is no longer used. *@
<FluentProviders />

@* v5: FluentOverlay dropped Transparent / InteractiveExceptId / PreventScroll, and Opacity is now an
   int percentage. CloseMode="Manual" replaces v4's InteractiveExceptId intent (the busy overlay
   can only be shown/hidden through BusyService.IsBusy and never by user interaction). *@
<FluentOverlay Visible="@_commonServices.BusyService.IsBusy"
			   FullScreen="true"
			   Interactive="true"
			   CloseMode="OverlayCloseMode.Manual"
			   Opacity="40">
	<div id="busyIndicator" style="width: 100vw; height: 100vh; display:flex; align-items:center; justify-content:center">
		<FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center">
			<FluentSpinner />
			<FluentText>@_commonServices.BusyService.BusyMessage</FluentText>
		</FluentStack>
	</div>

</FluentOverlay>
