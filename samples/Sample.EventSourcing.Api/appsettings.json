{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "i-synergy-sample",
    "Audience": "i-synergy-sample-api"
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:7001" ]
  },
  "EventArchive": {
    "RetentionDays": 0,
    "BatchSize": 50
  }
}
