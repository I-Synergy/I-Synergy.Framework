{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Aspire AppHost",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/samples/Sample.AppHost/Sample.AppHost.csproj",
            "launchProfile": "https"
        },
        {
            "name": "Aspire AppHost (.NET 10)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: AppHost (.NET 10)",
            "program": "${workspaceFolder}/samples/Sample.AppHost/bin/Debug/net10.0/Sample.AppHost.dll",
            "cwd": "${workspaceFolder}/samples/Sample.AppHost",
            "launchSettingsFilePath": "${workspaceFolder}/samples/Sample.AppHost/Properties/launchSettings.json",
            "launchSettingsProfile": "https",
            "env": {
                "SampleTargetFramework": "net10.0"
            }
        },
        {
            "name": "Aspire AppHost (.NET 11)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: AppHost (.NET 11)",
            "program": "${workspaceFolder}/samples/Sample.AppHost/bin/Debug/net11.0/Sample.AppHost.dll",
            "cwd": "${workspaceFolder}/samples/Sample.AppHost",
            "launchSettingsFilePath": "${workspaceFolder}/samples/Sample.AppHost/Properties/launchSettings.json",
            "launchSettingsProfile": "https",
            "env": {
                "SampleTargetFramework": "net11.0"
            }
        },
        {
            "name": ".NET MAUI",
            "type": "maui",
            "request": "launch",
            "preLaunchTask": "maui: Build"
        },
        {
            "name": "Sample.WPF (.NET 10)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: Sample.WPF (.NET 10)",
            "program": "${workspaceFolder}/samples/Sample.WPF/bin/Debug/net10.0-windows/Sample.exe",
            "cwd": "${workspaceFolder}/samples/Sample.WPF/bin/Debug/net10.0-windows"
        },
        {
            "name": "Sample.WPF (.NET 11)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: Sample.WPF (.NET 11)",
            "program": "${workspaceFolder}/samples/Sample.WPF/bin/Debug/net11.0-windows/Sample.exe",
            "cwd": "${workspaceFolder}/samples/Sample.WPF/bin/Debug/net11.0-windows"
        },
        {
            "name": "Sample.WinUI (.NET 10)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: Sample.WinUI (.NET 10)",
            "program": "${workspaceFolder}/samples/Sample.WinUI/bin/arm64/Debug/net10.0-windows10.0.26100.0/win-arm64/Sample.exe",
            "args": [
                "?environment=local&country=nl"
            ],
            "cwd": "${workspaceFolder}/samples/Sample.WinUI/bin/arm64/Debug/net10.0-windows10.0.26100.0/win-arm64"
        },
        {
            "name": "Sample.WinUI (.NET 11)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: Sample.WinUI (.NET 11)",
            "program": "${workspaceFolder}/samples/Sample.WinUI/bin/arm64/Debug/net11.0-windows10.0.26100.0/win-arm64/Sample.exe",
            "args": [
                "?environment=local&country=nl"
            ],
            "cwd": "${workspaceFolder}/samples/Sample.WinUI/bin/arm64/Debug/net11.0-windows10.0.26100.0/win-arm64"
        },
        {
            "name": "Sample.Maui (Windows, .NET 11)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build: Sample.Maui (Windows, .NET 11)",
            "program": "${workspaceFolder}/samples/Sample.Maui/bin/Debug/net11.0-windows10.0.26100.0/win-arm64/Sample.Maui.exe",
            "cwd": "${workspaceFolder}/samples/Sample.Maui/bin/Debug/net11.0-windows10.0.26100.0/win-arm64",
            "env": {
                "Environment": "Staging"
            }
        },
        {
            // Same approach for Mac Catalyst (also CoreCLR on .NET 11).
            "name": "Sample.Maui (Mac Catalyst, .NET 11)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "maui: Build (Mac Catalyst .NET 11)",
            "program": "${workspaceFolder}/samples/Sample.Maui/bin/Debug/net11.0-maccatalyst/maccatalyst-arm64/Sample.app/Contents/MacOS/Sample.Maui",
            "cwd": "${workspaceFolder}/samples/Sample.Maui/bin/Debug/net11.0-maccatalyst/maccatalyst-arm64",
            "env": {
                "Environment": "Staging"
            }
        },
        {
            // Android has to be deployed to an emulator/device before anything can attach, so it still
            // goes through the MAUI extension and needs its startup project selected.
            "name": "Sample.Maui (Android, .NET 11)",
            "type": "maui",
            "request": "launch",
            "project": "${workspaceFolder}/samples/Sample.Maui/Sample.Maui.csproj",
            "configuration": "Debug",
            "targetFramework": "net11.0-android",
            "preLaunchTask": "maui: Build (Android .NET 11)",
            "env": {
                "Environment": "Staging"
            }
        },
        {
            "name": "Attach: Sample (WPF / WinUI, dotnet watch)",
            "type": "coreclr",
            "request": "attach",
            "processName": "Sample"
        },
        {
            "type": "winapp",
            "request": "launch",
            "name": "WinApp: Launch and Attach"
        }
    ]
}
