<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>$(SampleTargetFramework)</TargetFramework>
		<RootNamespace>Sample.Blazor.UI.Tests</RootNamespace>
		<AssemblyName>Sample.Blazor.UI.Tests</AssemblyName>
		<IsPackable>false</IsPackable>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="MSTest.TestAdapter" />
		<PackageReference Include="MSTest.TestFramework" />
		<PackageReference Include="Microsoft.Playwright" />
		<PackageReference Include="Microsoft.Playwright.MSTest" />
	</ItemGroup>

	<!--
	  Installs the browser build the pinned Microsoft.Playwright version expects (chromium-1234 for
	  Playwright 1.62.0). This is a no-op when the browser is already in %USERPROFILE%\AppData\Local
	  \ms-playwright, and the suite fails with a clear message if the browser is missing.
	-->
	<Target Name="InstallPlaywrightBrowsers" AfterTargets="Build">
		<Exec Command="pwsh -Command &quot;&amp; '$(TargetDir)playwright.ps1' install chromium&quot;"
			  IgnoreExitCode="true"
			  ContinueOnError="true" />
	</Target>

</Project>
