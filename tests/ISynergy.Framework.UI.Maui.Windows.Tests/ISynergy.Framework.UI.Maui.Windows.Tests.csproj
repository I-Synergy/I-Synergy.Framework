<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <UseMaui>true</UseMaui>
    <IsPackable>false</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>ISynergy.Framework.UI.Maui</RootNamespace>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <!-- ISynergy.Framework.UI.Maui only exposes its windows TFM on a Windows host (its other TFMs are
         android/ios/maccatalyst), so referencing it from a net*-windows test project cannot
         resolve on macOS and fails the whole solution restore with NU1201. The project itself is
         Windows-only; restore it there, where the windows TFM exists. -->
    <ProjectReference Include="..\..\src\ISynergy.Framework.UI.Maui\ISynergy.Framework.UI.Maui.csproj"
                      Condition="$([MSBuild]::IsOSPlatform('windows'))" />
    <ProjectReference Include="..\ISynergy.Framework.UI.Tests\ISynergy.Framework.UI.Tests.csproj" />
  </ItemGroup>
</Project>