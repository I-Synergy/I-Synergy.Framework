<UserControl
    x:Class="ISynergy.Framework.UI.Controls.BladeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="BladeViewControl"
    mc:Ignorable="d">

    <!--
        Visual host for the framework blade (edge pane) concept.

        The positioning container is forced to LeftToRight on purpose: WPF mirrors the
        layout coordinate system under FlowDirection=RightToLeft, which would make
        HorizontalAlignment.Left/Right ambiguous inside a mirrored container. Keeping the
        positioning container LTR guarantees that HorizontalAlignment.Left/Right are
        physically left/right. The ambient flow direction is read from this control and
        applied to each blade's Frame so the blade CONTENT mirrors correctly.
    -->
    <Grid>
        <Border x:Name="ScrimBorder" Background="#80000000" />
        <Grid x:Name="PositioningRoot" FlowDirection="LeftToRight">
            <StackPanel
                x:Name="BladesPanel"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Orientation="Horizontal" />
        </Grid>
    </Grid>
</UserControl>
