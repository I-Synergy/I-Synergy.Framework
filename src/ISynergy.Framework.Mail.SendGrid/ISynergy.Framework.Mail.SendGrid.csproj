<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(BundledNETCoreAppPackageVersion)', '11.0'))">$(TargetFrameworks);net11.0</TargetFrameworks>
		<PackageId>I-Synergy.Framework.Mail.SendGrid</PackageId>
		<Description>I-Synergy Framework Mail with SendGrid</Description>
		<PackageTags>I-Synergy, Framework, Mail, SendGrid</PackageTags>
		<GenerateLibraryLayout>true</GenerateLibraryLayout>
  </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SendGrid" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="Microsoft.Extensions.Options" />
	</ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ISynergy.Framework.Mail\ISynergy.Framework.Mail.csproj" />
    </ItemGroup>
</Project>
