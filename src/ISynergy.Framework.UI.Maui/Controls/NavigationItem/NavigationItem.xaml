<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:ISynergy.Framework.UI.Behaviors;assembly=ISynergy.Framework.UI.Maui"
             xmlns:controls="clr-namespace:ISynergy.Framework.UI.Controls"
             x:Class="ISynergy.Framework.UI.Controls.NavigationItem"
             x:Name="NavigationItemControl"
             x:DataType="controls:NavigationItem">
    <ContentView.Resources>
        <Style TargetType="Border">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource TintedGray200}, Dark={DynamicResource TintedGray900}}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource Primary}, Dark={DynamicResource TintedGray800}}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentView.Resources>

    <Border 
        Padding="18,15"
        Stroke="{AppThemeBinding Light={DynamicResource TintedGray200}, Dark={DynamicResource TintedGray900}}" 
        StrokeThickness="0.1" 
        StrokeShape="RoundRectangle 2">
        <Grid
            ColumnDefinitions="20,*"
            ColumnSpacing="10"
            behaviors:CursorBehavior.Cursor="Hand">
            <Image
                Grid.Column="0"
                VerticalOptions="Center"
                WidthRequest="16"
                Source="{Binding Icon, Source={x:Reference NavigationItemControl}}"/>

            <Label
                Grid.Column="1"
                FontSize="12"
                Text="{Binding Text, Source={x:Reference NavigationItemControl}}"
                VerticalOptions="Center" />
        
            <Grid.GestureRecognizers>
                <TapGestureRecognizer
                    Command="{Binding Command, Source={x:Reference NavigationItemControl}}"
                    CommandParameter="{Binding CommandParameter, Source={x:Reference NavigationItemControl}}"
                    NumberOfTapsRequired="1" />
            </Grid.GestureRecognizers>
        </Grid>
    </Border>
</ContentView>