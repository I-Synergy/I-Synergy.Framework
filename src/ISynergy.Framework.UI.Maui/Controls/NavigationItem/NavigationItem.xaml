<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ISynergy.Framework.UI.Controls"
             x:Class="ISynergy.Framework.UI.Controls.NavigationItem"
             x:Name="NavigationItemControl"
             x:DataType="controls:NavigationItem">

    <ContentView.Resources>
        <Style TargetType="Border">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource TintedGray100}, Dark={DynamicResource TintedGray900}}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={DynamicResource TintedGray150}, Dark={DynamicResource TintedGray850}}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.5" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentView.Resources>

    <Border
        Padding="15"
        BackgroundColor="{AppThemeBinding Light={DynamicResource TintedGray100}, Dark={DynamicResource TintedGray900}}"
        Stroke="{AppThemeBinding Light={DynamicResource TintedGray200}, Dark={DynamicResource TintedGray900}}"
        StrokeThickness="0.1"
        StrokeShape="RoundRectangle 2">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition>
                    <ColumnDefinition.Width>
                        <OnPlatform x:TypeArguments="GridLength">
                            <On Platform="iOS" Value="24" />
                            <On Platform="Android" Value="20" />
                            <On Platform="WinUI" Value="20" />
                        </OnPlatform>
                    </ColumnDefinition.Width>
                </ColumnDefinition>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="0"
                VerticalOptions="Center"
                Aspect="Center"
                Source="{Binding Icon, Source={x:Reference NavigationItemControl}}"/>

            <Label
                Grid.Column="1"
                Text="{Binding Text, Source={x:Reference NavigationItemControl}}"
                VerticalOptions="Center">
                <Label.FontSize>
                    <OnPlatform x:TypeArguments="x:Double">
                        <On Platform="iOS" Value="14" />
                        <On Platform="Android" Value="12" />
                        <On Platform="WinUI" Value="12" />
                    </OnPlatform>
                </Label.FontSize>
            </Label>
        </Grid>

        <Border.GestureRecognizers>
            <TapGestureRecognizer
                Command="{Binding Command, Source={x:Reference NavigationItemControl}}"
                CommandParameter="{Binding CommandParameter, Source={x:Reference NavigationItemControl}}"
                NumberOfTapsRequired="1" />
        </Border.GestureRecognizers>
    </Border>
</ContentView>
