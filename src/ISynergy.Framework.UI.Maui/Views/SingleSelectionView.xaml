<?xml version="1.0" encoding="utf-8" ?>
<c:View
    x:Class="ISynergy.Framework.UI.SingleSelectionView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:c="clr-namespace:ISynergy.Framework.UI.Controls;assembly=ISynergy.Framework.UI.Maui"
    xmlns:m="clr-namespace:ISynergy.Framework.UI.Markup;assembly=ISynergy.Framework.UI.Maui"
    xmlns:vm="clr-namespace:ISynergy.Framework.Mvvm.Abstractions.ViewModels;assembly=ISynergy.Framework.Mvvm"
    x:DataType="vm:ISelectionViewModel">

    <Grid Padding="4" RowDefinitions="Auto,*,Auto">
        <Label
            Grid.Row="0"
            Margin="4,2"
            FontSize="20"
            Text="{Binding Title}" />

        <CollectionView
            x:Name="DataSummary"
            Grid.Row="1"
            ItemsSource="{Binding Items}"
            SelectionMode="Single">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Null}">
                    <Grid Padding="10">
                        <Label Margin="10,0" Text="{Binding}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout
            Grid.Row="2"
            Margin="0,4"
            HorizontalOptions="End"
            Spacing="8">
            <Button Command="{Binding SelectCommand}" CommandParameter="{Binding SelectedItem}" Text="{m:GetString Ok}" />
            <Button Command="{Binding CancelCommand}" Text="{m:GetString Cancel}" />
        </HorizontalStackLayout>
    </Grid>
</c:View>
