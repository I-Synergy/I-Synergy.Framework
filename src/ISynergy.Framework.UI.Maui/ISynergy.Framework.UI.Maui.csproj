<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(BundledNETCoreAppPackageVersion)', '11.0'))">$(TargetFrameworks);net11.0-android;net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.26100.0</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(BundledNETCoreAppPackageVersion)', '11.0')) And $([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.26100.0</TargetFrameworks>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
		<!--
			XC0022: reported for {TemplateBinding} inside the ControlTemplates in Resources/Styles/Generic.xaml
			        (MAUI 11 flags TemplateBinding as "could be compiled"), and for item templates whose item
			        type is a generic parameter that cannot be named in XAML.
			XC0023: reported when such a generic item template opts out of the inherited x:DataType with
			        x:DataType="{x:Null}"; without the opt-out the binding would be compiled against the
			        outer ViewModel type and break at runtime (XC0024/XC0045).
			Every remaining binding in this project declares its data type, so these two are noise.
		-->
		<NoWarn>$(NoWarn);XC0022;XC0023</NoWarn>

		<PackageId>I-Synergy.Framework.UI.Maui</PackageId>
		<Description>I-Synergy UI Framework for .Net Maui</Description>
		<PackageTags>I-Synergy, Framework, UI, Windows, Linux, Android, IOS, Maui</PackageTags>
		<IncludeSymbols>true</IncludeSymbols>
		<IncludeBuildOutput>true</IncludeBuildOutput>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<RootNamespace>ISynergy.Framework.UI</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IsTrimmable>true</IsTrimmable>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And $(TargetFramework.StartsWith('net11.0'))">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>
	
  <ItemGroup>
		<MauiFont Include="Resources\Fonts\*" />
	</ItemGroup>
	
  <ItemGroup>
		<!-- Ship font files in NuGet package so they are available to consuming apps -->
		<None Include="Resources\Fonts\*" Pack="true" PackagePath="contentFiles\any\any\Resources\Fonts\%(Filename)%(Extension)" />
		<!-- Ship MSBuild targets so fonts are added as MauiFont items in consuming apps -->
		<None Include="I-Synergy.Framework.UI.Maui.targets" Pack="true" PackagePath="buildTransitive\%(Filename)%(Extension)" />
	</ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.Configuration" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" />
		<PackageReference Include="Microsoft.Extensions.Logging" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Http" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
		<PackageReference Include="Microsoft.Maui.Controls" />
	</ItemGroup>

	<!-- Microsoft.Maui.Controls.Compatibility is only shipped for .NET 10; MAUI 11 no longer needs it. -->
	<ItemGroup Condition="$(TargetFramework.StartsWith('net10.0'))">
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ISynergy.Framework.Mvvm\ISynergy.Framework.Mvvm.csproj" />
		<ProjectReference Include="..\ISynergy.Framework.UI\ISynergy.Framework.UI.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Using Include="ISynergy.Framework.Mvvm.Abstractions.IView">
			<Alias>IView</Alias>
		</Using>
		<Using Include="ISynergy.Framework.Mvvm.Abstractions.IWindow">
			<Alias>IWindow</Alias>
		</Using>
		<Using Include="ISynergy.Framework.UI.Controls.Window">
			<Alias>Window</Alias>
		</Using>
		<Using Include="ISynergy.Framework.UI.Controls.View">
			<Alias>View</Alias>
		</Using>
	</ItemGroup>
	<ItemGroup>
	  <Compile Update="Windows\MultipleSelectionWindow.xaml.cs">
	    <DependentUpon>MultipleSelectionWindow.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Windows\SingleSelectionWindow.xaml.cs">
	    <DependentUpon>SingleSelectionWindow.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\SingleSelectionView.xaml.cs">
	    <DependentUpon>SingleSelectionView.xaml</DependentUpon>
	  </Compile>
	  <Compile Update="Views\MultipleSelectionView.xaml.cs">
	    <DependentUpon>MultipleSelectionView.xaml</DependentUpon>
	  </Compile>
	</ItemGroup>
	<ItemGroup>
		<MauiXaml Update="Controls\ErrorPresenter\ErrorPresenter.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Controls\ImageBrowser\ImageBrowser.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Controls\NavigationItem\NavigationItem.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Resources\Styles\Generic.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Windows\NoteWindow.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Windows\SingleSelectionWindow.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Windows\MultipleSelectionWindow.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\SingleSelectionView.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\MultipleSelectionView.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>
</Project>
