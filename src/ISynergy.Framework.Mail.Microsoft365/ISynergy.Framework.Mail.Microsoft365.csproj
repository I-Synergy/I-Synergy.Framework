	</ItemGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\ISynergy.Framework.Mail\ISynergy.Framework.Mail.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="ISynergy.Framework.Mail.Microsoft365.Tests" />
	</ItemGroup>
</Project>
