<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(BundledNETCoreAppPackageVersion)', '11.0'))">$(TargetFrameworks);net11.0</TargetFrameworks>
		<PackageId>I-Synergy.Framework.OpenTelemetry.Sentry</PackageId>
		<Description>I-Synergy Framework OpenTelemetry for Sentry</Description>
		<PackageTags>I-Synergy, Framework, OpenTelemetry, Sentry.io, Windows, Uno</PackageTags>
		<GenerateLibraryLayout>true</GenerateLibraryLayout>
		<EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Sentry.OpenTelemetry.Exporter" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\ISynergy.Framework.OpenTelemetry\ISynergy.Framework.OpenTelemetry.csproj" />
	</ItemGroup>
</Project>
